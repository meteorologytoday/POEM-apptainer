Bootstrap: localimage
From:  /home/tienyiao/projects_local/poem_apptainer/rockylinux_8.10_fixed-perm.sif
Stage: build

%post
    
    echo "Post processing..."
    dnf clean all

    dnf reinstall -y tcsh python3 git which vim
    dnf groupinstall -y "Development Tools"

    echo "Installing spack for package management in HPC environment"
    git clone --depth=2 https://github.com/spack/spack.git /spack

    SPACK=/spack/bin/spack

    $SPACK install intel-oneapi-compilers@2023.2.0 %gcc
    $SPACK install intel-oneapi-mpi                %intel-oneapi-compilers
    $SPACK install hdf5+mpi                        %intel-oneapi-compilers
    $SPACK install netcdf-c@4.9.2+parallel-netcdf  %intel-oneapi-compilers
    $SPACK install netcdf-fortran                  %intel-oneapi-compilers
    $SPACK install json-c                          %intel-oneapi-compilers
    $SPACK install expat                           %intel-oneapi-compilers
    $SPACK install udunits                         %intel-oneapi-compilers
    
    # Make POEM directory
    mkdir /POEM_UNI
    mkdir /POEM_UNI/bashrc.d
   
%environment

    export SPACK_ROOT=/spack
    export POEM_UNI=/POEM_UNI
    export POEM=${POEM_UNI}/poem
    export LC_ALL=C
    export PATH=${SPACK_ROOT}/bin:${PATH}

    if [ -d ${POEM_UNI}/bashrc.d ]; then
        for f in ${POEM_UNI}/bashrc.d/*.sh; do
            if [ -r $f ]; then
                echo "Sourcing file: $f"
                source $f
            fi
        done
        unset f
    fi

%runscript
    echo "RUNSCRIPT MODE"
